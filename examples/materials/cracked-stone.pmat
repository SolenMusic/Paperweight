# Paperweight showcase recipe: cracked stone
pmat.version = 7
material.type = fbm
material.seed = 41041
material.width = 1m
material.height = 1m
colour.low = 0x9A958CFF
colour.high = 0x171513FF
noise.frequency = 6
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.52
normal.strength = 4.5
roughness.low = 0.72
roughness.high = 0.96
layers.count = 6
# Primary branching fissure network
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
