# Paperweight stylised showcase: toon dungeon stones
pmat.version = 8
material.type = fbm
material.seed = 1337
material.width = 1m
material.height = 1m
colour.low = 0x171A20FF
colour.high = 0xC3B58DFF
noise.frequency = 5
noise.octaves = 4
noise.lacunarity = 2
noise.gain = 0.54
normal.strength = 3.2
roughness.low = 0.9
roughness.high = 0.48
layers.count = 3
# Rounded, irregular flagstones provide the physical surface.
layer.0.enabled = true
layer.0.operation = worley_cells
layer.0.composite = blend
layer.0.opacity = 1
layer.0.worley.columns = 7
layer.0.worley.rows = 6
layer.0.worley.jitter = 0.86
layer.0.worley.edge_width = 0.32
layer.0.worley.seed_offset = 17
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.035
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 23
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# A stepped ramp paints distinct dungeon-stone light and colour planes.
layer.1.enabled = true
layer.1.operation = colour_ramp
layer.1.composite = blend
layer.1.opacity = 1
layer.1.ramp.mode = stepped
layer.1.ramp.stops = 5
layer.1.ramp.stop.0.position = 0
layer.1.ramp.stop.0.colour = 0x171A20FF
layer.1.ramp.stop.1.position = 0.2
layer.1.ramp.stop.1.colour = 0x303942FF
layer.1.ramp.stop.2.position = 0.46
layer.1.ramp.stop.2.colour = 0x596258FF
layer.1.ramp.stop.3.position = 0.72
layer.1.ramp.stop.3.colour = 0x8E876DFF
layer.1.ramp.stop.4.position = 1
layer.1.ramp.stop.4.colour = 0xC3B58DFF
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# Dark contours describe stone boundaries without changing height or normals.
layer.2.enabled = true
layer.2.operation = ink_contour
layer.2.composite = blend
layer.2.opacity = 1
layer.2.ink.colour = 0x11141AFF
layer.2.ink.radius = 0.014
layer.2.ink.threshold = 0.105
layer.2.ink.softness = 0.025
layer.2.ink.strength = 0.9
layer.2.ink.inverted = false
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 0
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
