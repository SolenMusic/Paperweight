# Paperweight showcase recipe: knotty wood
pmat.version = 7
material.type = fbm
material.seed = 161803
material.width = 1m
material.height = 1m
colour.low = 0x3A1E0EFF
colour.high = 0xC58A45FF
noise.frequency = 5
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.5
normal.strength = 2.2
roughness.low = 0.82
roughness.high = 0.46
layers.count = 8
# Elongated tonal variation establishes the body of the timber
layer.0.enabled = true
layer.0.operation = noise
layer.0.composite = blend
layer.0.opacity = 1
layer.0.noise.seed_offset = 51
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 5
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.08
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 57
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Flowing growth bands run through the underlying colour variation
layer.1.enabled = true
layer.1.operation = surface_pattern
layer.1.composite = blend
layer.1.opacity = 0.42
layer.1.surface.kind = bands
layer.1.surface.scale = 13
layer.1.surface.width = 0.28
layer.1.surface.detail = 0.64
layer.1.surface.distortion = 0.46
layer.1.surface.variation = 0.88
layer.1.surface.seed_offset = 119
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = true
layer.1.warp.strength = 0.11
layer.1.warp.frequency = 2
layer.1.warp.seed_offset = 127
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 131
layer.1.mask.input_low = 0.48
layer.1.mask.input_high = 0.73
# Blend the two broad structures into fibrous timber
layer.2.enabled = true
layer.2.operation = surface_filter
layer.2.composite = blend
layer.2.opacity = 0.24
layer.2.filter.kind = soften
layer.2.filter.radius = 0.006
layer.2.filter.strength = 0.85
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 0
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
# Fine open pores follow the direction of the grain
layer.3.enabled = true
layer.3.operation = surface_pattern
layer.3.composite = multiply
layer.3.opacity = 0.12
layer.3.surface.kind = streaks
layer.3.surface.scale = 25
layer.3.surface.width = 0.055
layer.3.surface.detail = 0.92
layer.3.surface.distortion = 0.12
layer.3.surface.variation = 0.84
layer.3.surface.seed_offset = 193
layer.3.transform.scale_x = 1
layer.3.transform.scale_y = 1
layer.3.transform.offset_x = 0
layer.3.transform.offset_y = 0
layer.3.transform.rotation = 90
layer.3.warp.enabled = false
layer.3.warp.strength = 0
layer.3.warp.frequency = 1
layer.3.warp.seed_offset = 0
layer.3.mask.enabled = false
layer.3.mask.inverted = false
layer.3.mask.seed_offset = 0
layer.3.mask.input_low = 0
layer.3.mask.input_high = 1
# Subtle cellular colour variation in the fibres
layer.4.enabled = true
layer.4.operation = noise
layer.4.composite = multiply
layer.4.opacity = 0.08
layer.4.noise.seed_offset = 241
layer.4.transform.scale_x = 7
layer.4.transform.scale_y = 2
layer.4.transform.offset_x = -0.09
layer.4.transform.offset_y = 0.17
layer.4.transform.rotation = 90
layer.4.warp.enabled = true
layer.4.warp.strength = 0.05
layer.4.warp.frequency = 3
layer.4.warp.seed_offset = 251
layer.4.mask.enabled = false
layer.4.mask.inverted = false
layer.4.mask.seed_offset = 0
layer.4.mask.input_low = 0
layer.4.mask.input_high = 1
# Tighten the tonal range without losing the softer grain
layer.5.enabled = true
layer.5.operation = levels
layer.5.composite = blend
layer.5.opacity = 0.42
layer.5.levels.input_low = 0.08
layer.5.levels.input_high = 0.93
layer.5.levels.gamma = 0.92
layer.5.transform.scale_x = 1
layer.5.transform.scale_y = 1
layer.5.transform.offset_x = 0
layer.5.transform.offset_y = 0
layer.5.transform.rotation = 0
layer.5.warp.enabled = false
layer.5.warp.strength = 0
layer.5.warp.frequency = 1
layer.5.warp.seed_offset = 0
layer.5.mask.enabled = false
layer.5.mask.inverted = false
layer.5.mask.seed_offset = 0
layer.5.mask.input_low = 0
layer.5.mask.input_high = 1
# Broken growth rings create a handful of knots and local swirls
layer.6.enabled = true
layer.6.operation = surface_pattern
layer.6.composite = blend
layer.6.opacity = 0.13
layer.6.surface.kind = rings
layer.6.surface.scale = 6
layer.6.surface.width = 0.34
layer.6.surface.detail = 0.84
layer.6.surface.distortion = 0.62
layer.6.surface.variation = 0.88
layer.6.surface.seed_offset = 313
layer.6.transform.scale_x = 1
layer.6.transform.scale_y = 1
layer.6.transform.offset_x = 0.18
layer.6.transform.offset_y = -0.09
layer.6.transform.rotation = 0
layer.6.warp.enabled = true
layer.6.warp.strength = 0.07
layer.6.warp.frequency = 2
layer.6.warp.seed_offset = 317
layer.6.mask.enabled = true
layer.6.mask.inverted = false
layer.6.mask.seed_offset = 331
layer.6.mask.input_low = 0.56
layer.6.mask.input_high = 0.75
# Warm heartwood patches interrupt the repeating grain colour
layer.7.enabled = true
layer.7.operation = solid_colour
layer.7.composite = blend
layer.7.opacity = 0.14
layer.7.solid.colour = 0xA6602EFF
layer.7.transform.scale_x = 2
layer.7.transform.scale_y = 2
layer.7.transform.offset_x = 0.21
layer.7.transform.offset_y = 0.04
layer.7.transform.rotation = 0
layer.7.warp.enabled = false
layer.7.warp.strength = 0
layer.7.warp.frequency = 1
layer.7.warp.seed_offset = 0
