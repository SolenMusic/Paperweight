# Paperweight showcase recipe: weathered metal
pmat.version = 7
material.type = fbm
material.seed = 90210
material.width = 1m
material.height = 1m
colour.low = 0x24282AFF
colour.high = 0xE1DDD2FF
noise.frequency = 8
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.48
normal.strength = 2.8
roughness.low = 0.88
roughness.high = 0.34
layers.count = 7
# Long exposed scratches in the metal surface
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
layer.0.opacity = 1
layer.0.surface.kind = streaks
layer.0.surface.scale = 14
layer.0.surface.width = 0.08
layer.0.surface.detail = 0.9
layer.0.surface.distortion = 0.18
layer.0.surface.variation = 0.85
layer.0.surface.seed_offset = 93
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = false
layer.0.warp.strength = 0
layer.0.warp.frequency = 1
layer.0.warp.seed_offset = 0
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Round the freshly exposed scratch edges
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.composite = blend
layer.1.opacity = 0.25
layer.1.filter.kind = soften
layer.1.filter.radius = 0.006
layer.1.filter.strength = 1
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# Dense impact pits, localised by a broader wear field
layer.2.enabled = true
layer.2.operation = surface_pattern
layer.2.composite = multiply
layer.2.opacity = 0.2
layer.2.surface.kind = scatter
layer.2.surface.scale = 20
layer.2.surface.width = 0.24
layer.2.surface.detail = 0.92
layer.2.surface.distortion = 0.12
layer.2.surface.variation = 0.88
layer.2.surface.seed_offset = 207
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 0
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = true
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 211
layer.2.mask.input_low = 0.38
layer.2.mask.input_high = 0.78
# Rust blooms over broad damp patches
layer.3.enabled = true
layer.3.operation = solid_colour
layer.3.composite = blend
layer.3.opacity = 0.62
layer.3.solid.colour = 0x78351EFF
layer.3.transform.scale_x = 2
layer.3.transform.scale_y = 2
layer.3.transform.offset_x = 0.13
layer.3.transform.offset_y = -0.27
layer.3.transform.rotation = 0
layer.3.warp.enabled = true
layer.3.warp.strength = 0.08
layer.3.warp.frequency = 2
layer.3.warp.seed_offset = 301
layer.3.mask.enabled = true
layer.3.mask.inverted = false
layer.3.mask.seed_offset = 307
layer.3.mask.input_low = 0.42
layer.3.mask.input_high = 0.7
# Fine oxidation and brushed-metal grain
layer.4.enabled = true
layer.4.operation = noise
layer.4.composite = multiply
layer.4.opacity = 0.11
layer.4.noise.seed_offset = 401
layer.4.transform.scale_x = 6
layer.4.transform.scale_y = 2
layer.4.transform.offset_x = 0
layer.4.transform.offset_y = 0
layer.4.transform.rotation = 90
layer.4.warp.enabled = true
layer.4.warp.strength = 0.06
layer.4.warp.frequency = 4
layer.4.warp.seed_offset = 409
layer.4.mask.enabled = false
layer.4.mask.inverted = false
layer.4.mask.seed_offset = 0
layer.4.mask.input_low = 0
layer.4.mask.input_high = 1
# Catch sharp transitions around scratches, pits, and rust
layer.5.enabled = true
layer.5.operation = surface_filter
layer.5.composite = add
layer.5.opacity = 0.08
layer.5.filter.kind = edge
layer.5.filter.radius = 0.003
layer.5.filter.strength = 0.75
layer.5.transform.scale_x = 1
layer.5.transform.scale_y = 1
layer.5.transform.offset_x = 0
layer.5.transform.offset_y = 0
layer.5.transform.rotation = 0
layer.5.warp.enabled = false
layer.5.warp.strength = 0
layer.5.warp.frequency = 1
layer.5.warp.seed_offset = 0
layer.5.mask.enabled = false
layer.5.mask.inverted = false
layer.5.mask.seed_offset = 0
layer.5.mask.input_low = 0
layer.5.mask.input_high = 1
# Dark dirt remains where the broad rust mask is absent
layer.6.enabled = true
layer.6.operation = solid_colour
layer.6.composite = blend
layer.6.opacity = 0.16
layer.6.solid.colour = 0x211F1CFF
layer.6.transform.scale_x = 3
layer.6.transform.scale_y = 3
layer.6.transform.offset_x = -0.19
layer.6.transform.offset_y = 0.07
layer.6.transform.rotation = 0
layer.6.warp.enabled = false
layer.6.warp.strength = 0
layer.6.warp.frequency = 1
layer.6.warp.seed_offset = 0
layer.6.mask.enabled = true
layer.6.mask.inverted = true
