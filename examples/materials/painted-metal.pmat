# Paperweight stylised showcase: painted metal
pmat.version = 8
material.type = fbm
material.seed = 424242
material.width = 1m
material.height = 1m
colour.low = 0x18242CFF
colour.high = 0xDAB968FF
noise.frequency = 7
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.48
normal.strength = 1.4
roughness.low = 0.78
roughness.high = 0.28
layers.count = 3
# Warped streaks establish brushed metal, scratches, and painted wear.
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
layer.0.opacity = 1
layer.0.surface.kind = streaks
layer.0.surface.scale = 12
layer.0.surface.width = 0.09
layer.0.surface.detail = 0.84
layer.0.surface.distortion = 0.28
layer.0.surface.variation = 0.76
layer.0.surface.seed_offset = 61
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 90
layer.0.warp.enabled = true
layer.0.warp.strength = 0.045
layer.0.warp.frequency = 3
layer.0.warp.seed_offset = 67
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Preserve purposeful edges while calming noisy colour variation only.
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.composite = blend
layer.1.opacity = 0.68
layer.1.filter.kind = edge_aware_soften
layer.1.filter.radius = 0.009
layer.1.filter.strength = 0.82
layer.1.filter.sensitivity = 0.16
layer.1.filter.target = colour
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# A small hand-picked palette gives the surface its painted-game character.
layer.2.enabled = true
layer.2.operation = palette
layer.2.composite = blend
layer.2.opacity = 1
layer.2.palette.colours = 6
layer.2.palette.entry.0.colour = 0x18242CFF
layer.2.palette.entry.1.colour = 0x29414AFF
layer.2.palette.entry.2.colour = 0x49615EFF
layer.2.palette.entry.3.colour = 0x8B7147FF
layer.2.palette.entry.4.colour = 0xB88D4FFF
layer.2.palette.entry.5.colour = 0xDAB968FF
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 0
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
