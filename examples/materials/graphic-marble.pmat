# Paperweight stylised showcase: graphic marble
pmat.version = 8
material.type = fbm
material.seed = 271828
material.width = 1m
material.height = 1m
colour.low = 0xEEE9DCFF
colour.high = 0x343D51FF
noise.frequency = 5
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.52
normal.strength = 0.18
roughness.low = 0.48
roughness.high = 0.2
layers.count = 3
# Broad warped ridges form veins while deliberately keeping relief subtle.
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
layer.0.opacity = 1
layer.0.surface.kind = ridged_noise
layer.0.surface.scale = 5
layer.0.surface.width = 0.085
layer.0.surface.detail = 0.72
layer.0.surface.distortion = 0.86
layer.0.surface.variation = 0.58
layer.0.surface.seed_offset = 101
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0.08
layer.0.transform.offset_y = -0.12
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.03
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 103
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Colour-only posterisation creates graphic mineral bands, not rocky height steps.
layer.1.enabled = true
layer.1.operation = posterise
layer.1.composite = blend
layer.1.opacity = 0.78
layer.1.posterise.bands = 5
layer.1.posterise.target = colour
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# Soft blue-grey linework accents only the most legible veins.
layer.2.enabled = true
layer.2.operation = ink_contour
layer.2.composite = blend
layer.2.opacity = 0.72
layer.2.ink.colour = 0x273147FF
layer.2.ink.radius = 0.012
layer.2.ink.threshold = 0.13
layer.2.ink.softness = 0.055
layer.2.ink.strength = 0.7
layer.2.ink.inverted = false
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 0
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
