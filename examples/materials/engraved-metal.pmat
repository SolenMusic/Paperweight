# Paperweight v0.0.23 showcase: engraved brushed metal
pmat.version = 16
material.type = fbm
material.seed = 230025
material.width = 0.8m
material.height = 0.8m
surface.relief_depth = 0.002m
colour.low = 0x202832FF
colour.high = 0xA8B0B5FF
noise.frequency = 7
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.48
normal.strength = 1.15
roughness.low = 0
roughness.high = 1
layers.count = 5
# Tile-compatible windings make a precise engraved lattice.
layer.0.enabled = true
layer.0.operation = lattice
layer.0.outputs = colour, height
layer.0.composite = blend
layer.0.opacity = 1
layer.0.lattice.kind = diamonds
layer.0.lattice.winding_x = 6
layer.0.lattice.winding_y = 6
layer.0.lattice.width = 0.065
layer.0.lattice.softness = 0.012
layer.0.lattice.phase = 0.5
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = false
layer.0.warp.strength = 0
layer.0.warp.frequency = 1
layer.0.warp.seed_offset = 0
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Invert only height so the bright decoration is cut into, rather than raised from, the plate.
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.outputs = height
layer.1.composite = blend
layer.1.opacity = 1
layer.1.filter.kind = invert
layer.1.filter.radius = 0
layer.1.filter.strength = 1
layer.1.filter.sensitivity = 0
layer.1.filter.target = scalar
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
layer.2.enabled = true
layer.2.operation = surface_pattern
layer.2.outputs = colour
layer.2.composite = detail
layer.2.opacity = 0.12
layer.2.surface.kind = streaks
layer.2.surface.scale = 28
layer.2.surface.width = 0.045
layer.2.surface.detail = 0.9
layer.2.surface.distortion = 0.12
layer.2.surface.variation = 0.55
layer.2.surface.seed_offset = 73
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0
layer.2.transform.offset_y = 0
layer.2.transform.rotation = 90
layer.2.warp.enabled = false
layer.2.warp.strength = 0
layer.2.warp.frequency = 1
layer.2.warp.seed_offset = 0
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
layer.3.enabled = true
layer.3.operation = surface_value
layer.3.outputs = roughness
layer.3.composite = blend
layer.3.opacity = 1
layer.3.surface.value = 0.22
layer.3.transform.scale_x = 1
layer.3.transform.scale_y = 1
layer.3.transform.offset_x = 0
layer.3.transform.offset_y = 0
layer.3.transform.rotation = 0
layer.3.warp.enabled = false
layer.3.warp.strength = 0
layer.3.warp.frequency = 1
layer.3.warp.seed_offset = 0
layer.3.mask.enabled = false
layer.3.mask.inverted = false
layer.3.mask.seed_offset = 0
layer.3.mask.input_low = 0
layer.3.mask.input_high = 1
# Brushing varies reflectivity independently from both engraving depth and colour.
layer.4.enabled = true
layer.4.operation = surface_pattern
layer.4.outputs = roughness
layer.4.composite = detail
layer.4.opacity = 0.08
layer.4.surface.kind = streaks
layer.4.surface.scale = 32
layer.4.surface.width = 0.038
layer.4.surface.detail = 0.95
layer.4.surface.distortion = 0.08
layer.4.surface.variation = 0.8
layer.4.surface.seed_offset = 79
layer.4.transform.scale_x = 1
layer.4.transform.scale_y = 1
layer.4.transform.offset_x = 0
layer.4.transform.offset_y = 0
layer.4.transform.rotation = 90
layer.4.warp.enabled = false
layer.4.warp.strength = 0
layer.4.warp.frequency = 1
layer.4.warp.seed_offset = 0
layer.4.mask.enabled = false
layer.4.mask.inverted = false
layer.4.mask.seed_offset = 0
layer.4.mask.input_low = 0
layer.4.mask.input_high = 1
