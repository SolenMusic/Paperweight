layer.3.noise.seed_offset = 211
layer.3.transform.scale_x = 2
layer.3.transform.scale_y = 2
layer.3.transform.offset_x = -0.11
layer.3.transform.offset_y = 0.22
layer.3.transform.rotation = 0
