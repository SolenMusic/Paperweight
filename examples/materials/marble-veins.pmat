# Paperweight showcase recipe: marble veins
pmat.version = 7
material.type = fbm
material.seed = 314159
material.width = 1m
material.height = 1m
colour.low = 0xE7E4DDFF
colour.high = 0x303743FF
noise.frequency = 5
noise.octaves = 5
noise.lacunarity = 2
noise.gain = 0.54
normal.strength = 0.35
roughness.low = 0.52
roughness.high = 0.22
layers.count = 7
# Main dark veins meander through pale stone
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
layer.0.opacity = 1
layer.0.surface.kind = ridged_noise
layer.0.surface.scale = 5
layer.0.surface.width = 0.075
layer.0.surface.detail = 0.78
layer.0.surface.distortion = 0.82
layer.0.surface.variation = 0.64
layer.0.surface.seed_offset = 73
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.035
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 79
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Mineral diffusion softens the primary vein edges
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.composite = blend
layer.1.opacity = 0.34
layer.1.filter.kind = soften
layer.1.filter.radius = 0.008
layer.1.filter.strength = 1
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# A second finer vein family crosses the main structure
layer.2.enabled = true
layer.2.operation = surface_pattern
layer.2.composite = multiply
layer.2.opacity = 0.18
layer.2.surface.kind = ridged_noise
layer.2.surface.scale = 12
layer.2.surface.width = 0.035
layer.2.surface.detail = 0.92
layer.2.surface.distortion = 0.72
layer.2.surface.variation = 0.78
layer.2.surface.seed_offset = 151
