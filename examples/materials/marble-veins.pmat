layer.2.mask.enabled = true
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 163
layer.2.mask.input_low = 0.38
layer.2.mask.input_high = 0.72
# Broad cloudy inclusions prevent a perfectly uniform slab
layer.3.enabled = true
layer.3.operation = noise
layer.3.composite = multiply
