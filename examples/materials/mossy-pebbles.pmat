# Paperweight showcase recipe: mossy pebbles
pmat.version = 7
material.type = fbm
material.seed = 7331
material.width = 1m
material.height = 1m
colour.low = 0x1B201DFF
colour.high = 0x999487FF
noise.frequency = 5
noise.octaves = 4
noise.lacunarity = 2
noise.gain = 0.58
normal.strength = 5
roughness.low = 0.93
roughness.high = 0.7
layers.count = 7
# Irregular rounded stones separated by dark joints
layer.0.enabled = true
layer.0.operation = worley_cells
layer.0.composite = blend
layer.0.opacity = 1
layer.0.worley.columns = 8
layer.0.worley.rows = 7
layer.0.worley.jitter = 0.92
layer.0.worley.edge_width = 0.29
layer.0.worley.seed_offset = 27
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.045
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 31
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Take the mathematical sharpness off the stone boundaries
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.composite = blend
layer.1.opacity = 0.22
layer.1.filter.kind = soften
layer.1.filter.radius = 0.007
layer.1.filter.strength = 1
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# Mottled mineral variation within each pebble
layer.2.enabled = true
layer.2.operation = noise
layer.2.composite = multiply
layer.2.opacity = 0.13
layer.2.noise.seed_offset = 103
layer.2.transform.scale_x = 3
layer.2.transform.scale_y = 3
layer.2.transform.offset_x = 0.11
layer.2.transform.offset_y = -0.17
layer.2.transform.rotation = 0
layer.2.warp.enabled = true
layer.2.warp.strength = 0.08
layer.2.warp.frequency = 3
layer.2.warp.seed_offset = 107
layer.2.mask.enabled = false
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 0
layer.2.mask.input_low = 0
layer.2.mask.input_high = 1
# Tiny chips and pits on the exposed stone faces
layer.3.enabled = true
layer.3.operation = surface_pattern
layer.3.composite = multiply
layer.3.opacity = 0.1
layer.3.surface.kind = scatter
layer.3.surface.scale = 20
layer.3.surface.width = 0.25
layer.3.surface.detail = 0.9
layer.3.surface.distortion = 0.14
layer.3.surface.variation = 0.86
layer.3.surface.seed_offset = 181
layer.3.transform.scale_x = 1
layer.3.transform.scale_y = 1
layer.3.transform.offset_x = 0
layer.3.transform.offset_y = 0
layer.3.transform.rotation = 0
layer.3.warp.enabled = false
layer.3.warp.strength = 0
layer.3.warp.frequency = 1
layer.3.warp.seed_offset = 0
layer.3.mask.enabled = true
layer.3.mask.inverted = false
layer.3.mask.seed_offset = 191
layer.3.mask.input_low = 0.42
layer.3.mask.input_high = 0.76
# Deepen the joints and shallow hollows
layer.4.enabled = true
