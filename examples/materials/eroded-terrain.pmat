# Paperweight showcase recipe: eroded terrain
pmat.version = 7
material.type = fbm
material.seed = 8675309
material.width = 1m
material.height = 1m
colour.low = 0x4C3B28FF
colour.high = 0xB8A079FF
noise.frequency = 4
noise.octaves = 6
noise.lacunarity = 2
noise.gain = 0.58
normal.strength = 6
roughness.low = 0.92
roughness.high = 0.6
layers.count = 7
# Broad ridges and basins establish the landform
layer.0.enabled = true
layer.0.operation = surface_pattern
layer.0.composite = blend
layer.0.opacity = 1
layer.0.surface.kind = ridged_noise
layer.0.surface.scale = 6
layer.0.surface.width = 0.62
layer.0.surface.detail = 1
layer.0.surface.distortion = 0.55
layer.0.surface.variation = 0.8
layer.0.surface.seed_offset = 191
layer.0.transform.scale_x = 1
layer.0.transform.scale_y = 1
layer.0.transform.offset_x = 0
layer.0.transform.offset_y = 0
layer.0.transform.rotation = 0
layer.0.warp.enabled = true
layer.0.warp.strength = 0.06
layer.0.warp.frequency = 2
layer.0.warp.seed_offset = 197
layer.0.mask.enabled = false
layer.0.mask.inverted = false
layer.0.mask.seed_offset = 0
layer.0.mask.input_low = 0
layer.0.mask.input_high = 1
# Water-worn cavities cut into the broad relief
layer.1.enabled = true
layer.1.operation = surface_filter
layer.1.composite = blend
layer.1.opacity = 0.24
layer.1.filter.kind = cavity
layer.1.filter.radius = 0.035
layer.1.filter.strength = 0.85
layer.1.transform.scale_x = 1
layer.1.transform.scale_y = 1
layer.1.transform.offset_x = 0
layer.1.transform.offset_y = 0
layer.1.transform.rotation = 0
layer.1.warp.enabled = false
layer.1.warp.strength = 0
layer.1.warp.frequency = 1
layer.1.warp.seed_offset = 0
layer.1.mask.enabled = false
layer.1.mask.inverted = false
layer.1.mask.seed_offset = 0
layer.1.mask.input_low = 0
layer.1.mask.input_high = 1
# Distorted drainage lines run across the slopes
layer.2.enabled = true
layer.2.operation = surface_pattern
layer.2.composite = multiply
layer.2.opacity = 0.16
layer.2.surface.kind = bands
layer.2.surface.scale = 8
layer.2.surface.width = 0.14
layer.2.surface.detail = 0.82
layer.2.surface.distortion = 0.9
layer.2.surface.variation = 0.76
layer.2.surface.seed_offset = 251
layer.2.transform.scale_x = 1
layer.2.transform.scale_y = 1
layer.2.transform.offset_x = 0.12
layer.2.transform.offset_y = -0.18
layer.2.transform.rotation = 90
layer.2.warp.enabled = true
layer.2.warp.strength = 0.12
layer.2.warp.frequency = 2
layer.2.warp.seed_offset = 257
layer.2.mask.enabled = true
layer.2.mask.inverted = false
layer.2.mask.seed_offset = 263
layer.2.mask.input_low = 0.38
layer.2.mask.input_high = 0.7
# Pebbles and rain pits interrupt exposed soil
layer.3.enabled = true
layer.3.operation = surface_pattern
layer.3.composite = multiply
layer.3.opacity = 0.11
layer.3.surface.kind = scatter
layer.3.surface.scale = 16
layer.3.surface.width = 0.3
layer.3.surface.detail = 0.88
layer.3.surface.distortion = 0.2
layer.3.surface.variation = 0.88
layer.3.surface.seed_offset = 311
layer.3.transform.scale_x = 1
layer.3.transform.scale_y = 1
layer.3.transform.offset_x = 0
layer.3.transform.offset_y = 0
layer.3.transform.rotation = 0
layer.3.warp.enabled = false
layer.3.warp.strength = 0
layer.3.warp.frequency = 1
layer.3.warp.seed_offset = 0
layer.3.mask.enabled = true
layer.3.mask.inverted = false
layer.3.mask.seed_offset = 317
layer.3.mask.input_low = 0.42
layer.3.mask.input_high = 0.76
# Fine granular soil variation
layer.4.enabled = true
layer.4.operation = noise
layer.4.composite = multiply
layer.4.opacity = 0.1
layer.4.noise.seed_offset = 373
layer.4.transform.scale_x = 4
layer.4.transform.scale_y = 4
layer.4.transform.offset_x = -0.07
layer.4.transform.offset_y = 0.09
layer.4.transform.rotation = 0
layer.4.warp.enabled = true
layer.4.warp.strength = 0.08
layer.4.warp.frequency = 3
layer.4.warp.seed_offset = 379
layer.4.mask.enabled = false
layer.4.mask.inverted = false
layer.4.mask.seed_offset = 0
layer.4.mask.input_low = 0
layer.4.mask.input_high = 1
# Sunlit lips pick out the steepest erosion edges
layer.5.enabled = true
layer.5.operation = surface_filter
layer.5.composite = add
layer.5.opacity = 0.09
layer.5.filter.kind = edge
layer.5.filter.radius = 0.005
layer.5.filter.strength = 0.75
layer.5.transform.scale_x = 1
layer.5.transform.scale_y = 1
layer.5.transform.offset_x = 0
layer.5.transform.offset_y = 0
layer.5.transform.rotation = 0
layer.5.warp.enabled = false
layer.5.warp.strength = 0
layer.5.warp.frequency = 1
layer.5.warp.seed_offset = 0
layer.5.mask.enabled = false
layer.5.mask.inverted = false
layer.5.mask.seed_offset = 0
layer.5.mask.input_low = 0
layer.5.mask.input_high = 1
# Darker damp soil settles in broad, low-frequency patches
layer.6.enabled = true
layer.6.operation = solid_colour
layer.6.composite = blend
layer.6.opacity = 0.2
layer.6.solid.colour = 0x58442EFF
layer.6.transform.scale_x = 2
layer.6.transform.scale_y = 2
layer.6.transform.offset_x = 0.23
layer.6.transform.offset_y = -0.14
layer.6.transform.rotation = 0
layer.6.warp.enabled = false
layer.6.warp.strength = 0
layer.6.warp.frequency = 1
layer.6.warp.seed_offset = 0
